/*.tar.gz

# Output files from R CMD check
/*.Rcheck/

# RStudio files
.Rproj.user/

# produced vignettes
vignettes/*.html
vignettes/*.pdf

# OAuth2 token, see https://github.com/hadley/httr/releases/tag/v0.3
.httr-oauth

# knitr and R markdown default cache directories
*_cache/
/cache/

# Temporary files created by R markdown
*.utf8.md
*.knit.md

# R Environment Variables
.Renviron

# pkgdown site
docs/

# translation temp files
po/*~

# RStudio Connect folder
rsconnect/

# Spatial data - rasters
*.tif
*.tiff
*.img
*.asc
*.nc

# Spatial data - vectors
# Spatial vectors - ignore in data folders except sample
data/raw/*.shp
data/raw/*.dbf
data/raw/*.sbn
data/raw/*.sbx
data/raw/*.prj
data/raw/*.cpg
data/raw/*.shx
data/raw/*.gpkg
data/processed/*.shp
data/processed/*.dbf
data/processed/*.gpkg

# Large R data objects
*.rds
*.Rds
*.RDS

# Large CSVs and tabular data
data/raw/*.csv
data/processed/*.csv

# Outputs - solutions and maps
outputs/solutions/
outputs/maps/

# Gurobi
gurobi.lic
*.lic

# Sensitive config
.env
*_credentials*
*_licence*
*_password*

# Windows and OneDrive artefacts
Thumbs.db
Desktop.ini
*.tmp
~$*
.~lock.*

# ArcGIS
*.aprx.bak


*.tbx
__pycache__/
*.pyc

# Allow sample data regardless of extension
# Allow all sample data files
!data/sample/
!data/sample/**
!data/sample/shapefile_zip/
!data/sample/shapefile_zip/**
